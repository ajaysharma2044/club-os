# Generate a fresh value on the host; do not reuse test keys.
CEC_BOOTSTRAP_TOKEN=REPLACE_WITH_RANDOM_SECRET

# Outgoing email: disabled until a verified sender and key are configured.
CEC_EMAIL_MODE=disabled
# CEC_EMAIL_KEY=<64 hex characters; same external secret on web and email worker>
# CEC_EMAIL_FROM=Club OS <notifications@your-domain.example>
# RESEND_API_KEY=<provider API key>

# Supabase operational database (server-only; see docs/33-postgres-migration.md)
# CEC_STORAGE=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres
# DATABASE_SSL_CA_PEM="complete Supabase root certificate"
# CEC_POSTGRES_SCHEMA=club_os
# CEC_QUANT_DATABASE=/data/quant.sqlite
