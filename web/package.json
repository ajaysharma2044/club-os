    "test:clubhealth": "node --experimental-strip-types --import ./tests/ts-resolve-register.mjs tests/clubhealth.mjs",
    "test:assets": "node --experimental-strip-types --import ./tests/ts-resolve-register.mjs tests/assets.mjs",
    "test:checkin": "node --experimental-strip-types --import ./tests/ts-resolve-register.mjs tests/checkin.mjs",
